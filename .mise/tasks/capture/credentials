#!/usr/bin/env bash
#MISE description="Write the FlightWall api_key/user_id from the raw capture to a 0600 TOML file"
#MISE quiet=true
#USAGE arg "<output>" help="Path for the credential file, e.g. flightwall-credentials.toml"
#USAGE flag "--flow <path>" default="captures/flightwall.flow" help="mitmproxy flow file to read"

# Neither value is printed. The output is what [flightwall].credentials_path points at.

set -euo pipefail

OUTPUT="${usage_output:?}"
FLOW="${usage_flow:-captures/flightwall.flow}"

[ -f "$FLOW" ] || { echo "no capture at $FLOW; run mise run capture:start first" >&2; exit 1; }

ADDON="$(mktemp)"
trap 'rm -f "$ADDON"' EXIT
cat >"$ADDON" <<'PY'
import os
import sys

from mitmproxy import http

pair: dict[str, str] = {}


def response(flow: http.HTTPFlow) -> None:
    if flow.request.pretty_host == "api.theflightwall.com" and flow.request.path.startswith("/configuration"):
        pair["api_key"] = flow.request.headers.get("x-api-key", "")
        pair["user_id"] = flow.request.headers.get("x-user-id", "")


def done() -> None:
    if not pair.get("api_key") or not pair.get("user_id"):
        sys.stderr.write("no /configuration request with both headers found in the capture\n")
        return
    out = os.environ["FW_CREDENTIAL_OUTPUT"]
    fd = os.open(out, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as handle:
        handle.write(f'api_key = "{pair["api_key"]}"\nuser_id = "{pair["user_id"]}"\n')
    os.chmod(out, 0o600)
PY

FW_CREDENTIAL_OUTPUT="$OUTPUT" mitmdump -nr "$FLOW" -s "$ADDON" -q >/dev/null

if [ -s "$OUTPUT" ]; then
  echo "wrote $OUTPUT (mode 0600). Point [flightwall].credentials_path at it; never commit it."
else
  echo "nothing written" >&2
  exit 1
fi
