#!/usr/bin/env bash
#MISE description="Trust the mitmproxy CA, set the system proxy, run the capture proxy (Ctrl-C to stop)"
#MISE quiet=true
#USAGE flag "--service <service>" default="Wi-Fi" help="networksetup service to proxy"
#USAGE flag "--port <port>" default="8080" help="Proxy listen port on 127.0.0.1"
#USAGE flag "--web" help="Run mitmweb with a UI on 127.0.0.1:8081 instead of headless mitmdump"

# U4: authorized FlightWall capture from TheFlightWall.app on this Mac.
# Headless by default: the HAR is written to captures/flightwall.har on Ctrl-C.
# Undo with `mise run capture:stop`. Do not leave the CA trusted.

set -euo pipefail

SERVICE="${usage_service:-Wi-Fi}"
PORT="${usage_port:-8080}"
WEB="${usage_web:-false}"
CA_PEM="$HOME/.mitmproxy/mitmproxy-ca-cert.pem"
KEYCHAIN="$HOME/Library/Keychains/login.keychain-db"

mkdir -p captures

if [ ! -f "$CA_PEM" ]; then
  echo "generating mitmproxy CA"
  timeout 5 mitmdump --listen-host 127.0.0.1 --listen-port 0 >/dev/null 2>&1 || true
  [ -f "$CA_PEM" ] || { echo "CA was not generated" >&2; exit 1; }
fi

# Login keychain only, never System. Idempotent.
if ! security find-certificate -c mitmproxy "$KEYCHAIN" >/dev/null 2>&1; then
  echo "trusting mitmproxy CA in the login keychain (macOS will prompt)"
  security add-trusted-cert -r trustRoot -p ssl -k "$KEYCHAIN" "$CA_PEM"
fi

# iOS apps on macOS honour the system proxy; there is no per-app setting.
echo "$SERVICE proxy -> 127.0.0.1:$PORT"
networksetup -setwebproxy "$SERVICE" 127.0.0.1 "$PORT"
networksetup -setsecurewebproxy "$SERVICE" 127.0.0.1 "$PORT"
networksetup -setwebproxystate "$SERVICE" on
networksetup -setsecurewebproxystate "$SERVICE" on

cat <<EOF

proxy: 127.0.0.1:$PORT   flows: captures/flightwall.flow   HAR on exit: captures/flightwall.har

  1. Quit and relaunch TheFlightWall.app so it picks up the proxy (that is sequence 1).
  2. Run the sequences in docs/flightwall-api-discovery.md §3.
  3. Ctrl-C here, then: mise run capture:stop

A connection error in the app after relaunch means pinning: Ctrl-C, capture:stop, read §5.
EOF

if [ "$WEB" = "true" ]; then
  exec mitmweb --listen-host 127.0.0.1 --listen-port "$PORT" \
    --web-host 127.0.0.1 --web-port 8081 \
    --set save_stream_file=captures/flightwall.flow \
    --set hardump=captures/flightwall.har
fi

# One line per flow so a second terminal can tail progress; bodies stay in the flow file.
exec mitmdump --listen-host 127.0.0.1 --listen-port "$PORT" \
  --set save_stream_file=captures/flightwall.flow \
  --set hardump=captures/flightwall.har \
  --set flow_detail=1
